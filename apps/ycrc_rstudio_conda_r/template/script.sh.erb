#!/usr/bin/env bash

# 06/08/2022 now we need to load StdEnv since it is no longer provided for interactive session
#            to prevent 'scp' or 'rsync get bogged down with tons of modules loaded
module load StdEnv

# source the user's .bashrc
source ${HOME}/.bashrc

# Reset module environment (may require login shell for some HPC clusters)
module purge 


# Start up desktop
echo "Launching desktop '<%= context.desktop %>'..."
(
source "<%= session.staged_root.join("desktops", "#{context.desktop}.sh") %>"
) &

which eog
if [ $? == 0 ]; then
  eog -f ./wait.png &
  pid_saved=$!
else
  which eom
  if [ $? == 0 ]; then
    eom -f ./wait.png &
    pid_saved=$!
  fi
fi

# Change working directory to user's home directory
cd "${HOME}"

module load miniconda
conda activate <%= context.conda_r_env.strip() %>

which rstudio
[ $? != 0 ] && mamba install -y rstudio-desktop

[[ -v pid_saved ]] && kill $pid_saved

rstudio
